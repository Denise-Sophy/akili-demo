# Copy to .env and replace every token with a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Roles: lead (client:read, ops:read, memory:write) | client_lead (client:read, ops:read) | ops (ops:read)
AKILI_TOKENS={"REPLACE-denise-token": {"name": "denise", "role": "lead", "clients": ["*"]}, "REPLACE-globex-token": {"name": "globex_lead", "role": "client_lead", "clients": ["globex"]}, "REPLACE-intern-token": {"name": "ops_intern", "role": "ops", "clients": ["acme"]}}

ANTHROPIC_API_KEY=
AKILI_MCP_URL=http://localhost:8000/mcp
AKILI_COORDINATOR_MODEL=claude-sonnet-5-5
AKILI_SPECIALIST_MODEL=claude-haiku-4-5
AKILI_RATE_LIMIT_PER_MIN=120

# fixture (default, fictional data) or sheets
AKILI_DATA=fixture
# AKILI_SHEET_ID=
# GOOGLE_SA_JSON=path/to/service_account.json
